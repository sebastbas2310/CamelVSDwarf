# Marca el código generado por Lombok para que JaCoCo no lo cuente como
# cobertura manual. Esto mantiene los porcentajes centrados en la lógica de
# CamelVSDwarf y no en boilerplate de getters/setters/builders.
lombok.addLombokGeneratedAnnotation = true

# Evita que Lombok siga buscando configuración en directorios superiores.
config.stopBubbling = true