# Local Docker PostgreSQL defaults
DB_URL=jdbc:postgresql://localhost:5432/camel_vs_dwarf
DB_HOST=localhost
DB_PORT=5432
DB_NAME=camel_vs_dwarf
DB_USERNAME=camel_user
DB_PASSWORD=replace-with-a-local-password
DB_POOL_SIZE=5
DB_EXTERNAL_PORT=5432
BACKEND_PORT=8080
JPA_DDL_AUTO=update
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=3600000

# Supabase uses PostgreSQL, not MySQL. Use the JDBC connection string provided
# by Supabase and keep the password outside Git.
# For Render, prefer the Supabase connection pooler host if direct access fails.
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=replace-with-your-supabase-database-password
